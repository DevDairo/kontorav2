APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=local

# Frontend compilado y servido por Nginx. La URL relativa mantiene frontend y
# API bajo el mismo origen; Nginx reenvia /api al contenedor backend.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8081
FRONTEND_API_URL=/api

# PostgreSQL local dentro de Docker Compose
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=kontora_pos_postgres_local_data

# Datasource del backend cuando corra en Docker Compose local
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kontora_pos
DB_USER=kontora_pos
DB_PASSWORD=kontora_pos_local_password
DB_SSLMODE=disable

# JWT
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# Origenes locales exactos. Nginx mantiene frontend y API bajo un solo origen,
# pero Spring recibe la cabecera Origin reenviada y aplica igualmente esta lista.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# Tunnel nombrado administrado desde Cloudflare. Para una demostracion, agregar
# tambien a CORS_ALLOWED_ORIGINS el origen HTTPS exacto, sin ruta ni barra final.
# El token es secreto: copiarlo solo a infra/.env y nunca compartir ese archivo.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.2
CLOUDFLARE_TUNNEL_TOKEN=

# Provisiona el primer gerente solo cuando la tabla usuarios esta vacia.
# En la VM, activar y definir una contrasena exclusiva antes del primer arranque.
BOOTSTRAP_MANAGER_ENABLED=false
BOOTSTRAP_MANAGER_USERNAME=gerenteLocal
BOOTSTRAP_MANAGER_FULL_NAME=Gerente Local
BOOTSTRAP_MANAGER_PASSWORD=

# Supabase Storage autoalojado. Generar las dos claves con:
# powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\infra\scripts\New-StorageSecrets.ps1
STORAGE_BIND_ADDRESS=127.0.0.1
STORAGE_PORT=5000
STORAGE_VOLUME_NAME=kontora_pos_storage_local_data
STORAGE_DATABASE_URL=postgresql://kontora_pos:kontora_pos_local_password@postgres:5432/kontora_pos
STORAGE_DATABASE_MAX_CONNECTIONS=5
STORAGE_JWT_SECRET=
STORAGE_SERVICE_ROLE_KEY=
STORAGE_NAMESPACE=kontora-storage
STORAGE_REGION=local
STORAGE_FILE_SIZE_LIMIT=13631488
STORAGE_LOG_LEVEL=info
SUPABASE_STORAGE_BUCKET=kontoraimagenes
