# Esta plantilla no crea el tunel ni registros DNS. Primero validar Nginx y su
# proxy /api; despues crear el tunnel y el hostname en Cloudflare.
# Backend y Nginx se enlazan a loopback; el tunnel publicara solamente Nginx.
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
SPRING_PROFILES_ACTIVE=production

# Nginx publica el frontend solo en loopback. Cloudflare Tunnel apunta al
# servicio Docker http://frontend:8080 y /api se reenvia al backend.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8081
FRONTEND_API_URL=/api

# Fecha operativa de Colombia. Mantener ambas variables para que el sistema
# operativo y la JVM calculen ventas, precios y promociones con la misma fecha.
TZ=America/Bogota
JAVA_TOOL_OPTIONS=-Duser.timezone=America/Bogota

# PostgreSQL local en un contenedor independiente. El servicio no publica
# el puerto 5432 en el host y conserva sus datos en este volumen Docker.
POSTGRES_VOLUME_NAME=kontora_pos_postgres_prod_data
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kontora_pos
DB_USER=kontora_pos
DB_PASSWORD=
DB_SSLMODE=disable

# Seguridad de sesiones
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# Hostnames HTTPS exactos que Cloudflare publicara para Nginx. Aunque el
# navegador use /api en el mismo origen, Spring recibe Origin a traves del proxy
# y valida esta lista. Cambiarla si el dominio final es distinto; nunca usar *.
# No incluir rutas ni barra final. Declararlos no crea registros DNS.
CORS_ALLOWED_ORIGINS=https://kontora-pos.store

# Tunnel nombrado administrado remotamente desde Cloudflare. El hostname
# publico se configura en el panel con Service URL http://frontend:8080.
# Tras validar una version, fijar CLOUDFLARED_IMAGE por version o digest.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.2
CLOUDFLARE_TUNNEL_TOKEN=

# Supabase Storage autoalojado. La contrasena incluida en esta URL debe estar
# codificada para URL. Es mas sencillo generar DB_PASSWORD solo con caracteres
# base64url (letras, numeros, guion y guion bajo) y reutilizarla sin cambios.
STORAGE_VOLUME_NAME=kontora_pos_storage_prod_data
STORAGE_DATABASE_URL=
STORAGE_DATABASE_MAX_CONNECTIONS=5
STORAGE_JWT_SECRET=
STORAGE_SERVICE_ROLE_KEY=
STORAGE_NAMESPACE=kontora-storage
STORAGE_REGION=local
STORAGE_FILE_SIZE_LIMIT=13631488
STORAGE_LOG_LEVEL=warn
SUPABASE_STORAGE_BUCKET=kontoraimagenes

# Solo para el primer arranque contra una base sin usuarios.
BOOTSTRAP_MANAGER_ENABLED=true
BOOTSTRAP_MANAGER_USERNAME=gerenteLocal
BOOTSTRAP_MANAGER_FULL_NAME=Gerente Local
BOOTSTRAP_MANAGER_PASSWORD=
