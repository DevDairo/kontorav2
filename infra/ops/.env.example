# Entorno local: copiar como infra/ops/.env y generar una credencial con
# powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\infra\ops\scripts\New-OpsToken.ps1
OPS_ENVIRONMENT=local
OPS_BIND_ADDRESS=0.0.0.0
OPS_PORT=8090
OPS_HOST_BIND_ADDRESS=127.0.0.1
OPS_HOST_PORT=8090
OPS_AUTH_MODE=local-token
OPS_LOCAL_TOKEN=
OPS_EXECUTOR_TOKEN=

# Docker API restringida. No publicar este puerto en el host.
OPS_DOCKER_API_URL=http://docker-api-proxy:2375
OPS_DOCKER_PROXY_IMAGE=ghcr.io/tecnativa/docker-socket-proxy:v0.4.2
OPS_DIAGNOSTICS_TIMEOUT_MS=5000

# Recursos exactos del stack que el panel puede mostrar.
OPS_POSTGRES_CONTAINER=kontora_pos_postgres_local
OPS_STORAGE_CONTAINER=kontora_pos_storage_local
OPS_BACKEND_CONTAINER=kontora_pos_backend_local
OPS_FRONTEND_CONTAINER=kontora_pos_frontend_local
OPS_CLOUDFLARED_CONTAINER=kontora_pos_cloudflared_local
OPS_POSTGRES_VOLUME=kontora_pos_postgres_local_data
OPS_STORAGE_VOLUME=kontora_pos_storage_local_data

# Diagnósticos internos de solo lectura.
# La red predeterminada corresponde a infra/compose.*.yml sin -p personalizado.
OPS_POS_DATABASE_NETWORK=infra_database
OPS_DB_DIAGNOSTICS_ENABLED=true
OPS_DB_HOST=postgres
OPS_DB_PORT=5432
OPS_DB_NAME=kontora_pos
OPS_DB_USER=kontora_ops_reader
OPS_DB_PASSWORD=
OPS_DB_SSLMODE=disable
OPS_DB_DIAGNOSTICS_TIMEOUT_MS=5000
OPS_STORAGE_BUCKET=kontoraimagenes

# Bitácora operacional independiente.
OPS_AUDIT_VOLUME_NAME=kontora_ops_audit_local_data
OPS_AUDIT_DEFAULT_LIMIT=100
OPS_AUDIT_MAX_BYTES=52428800

# Respaldo local controlado. Este volumen no pertenece al stack reiniciable.
OPS_BACKUPS_ENABLED=true
OPS_BACKUP_VOLUME_NAME=kontora_ops_backups_local_data
OPS_BACKUP_TIMEOUT_MS=300000
OPS_RELEASE_VERSION=local-working-tree

# Producción con Cloudflare Access.
OPS_PUBLIC_HOSTNAME=operaciones.kontora-pos.store
OPS_CLOUDFLARE_TUNNEL_TOKEN=
OPS_CF_ACCESS_TEAM_DOMAIN=
OPS_CF_ACCESS_AUD=
OPS_ALLOWED_EMAILS=
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.2
